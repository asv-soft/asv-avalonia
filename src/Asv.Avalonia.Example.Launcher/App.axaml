<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Asv.Avalonia.Example.Launcher.App"
>
    <Application.Styles>
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="avares://Asv.Avalonia.Example.Launcher/Assets/asv-icon.png" />
        </Style>
        <FluentTheme />
        <StyleInclude Source="avares://Asv.Avalonia.Example.Launcher/Styles/ExampleLauncherStyles.axaml" />
    </Application.Styles>
</Application>
