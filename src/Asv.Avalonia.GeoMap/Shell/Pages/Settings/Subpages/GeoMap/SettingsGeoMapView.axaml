<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:geoMap="clr-namespace:Asv.Avalonia.GeoMap"
    mc:Ignorable="d"
    d:DesignWidth="980"
    d:DesignHeight="640"
    x:Class="Asv.Avalonia.GeoMap.SettingsGeoMapView"
    x:DataType="geoMap:SettingsGeoMapViewModel"
>
    <Design.DataContext>
        <geoMap:SettingsGeoMapViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding Editor}" />

        <GridSplitter
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Margin="16,0"
            Background="{DynamicResource ButtonBackground}"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
        />

        <Grid Grid.Row="2" Margin="16,8,16,16" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="4">
                <TextBlock Classes="h2" Text="{Binding MapPreviewHeader}" />
                <TextBlock
                    Classes="description"
                    Text="{Binding MapPreviewDescription}"
                    TextWrapping="Wrap"
                />
            </StackPanel>
            <Border
                Grid.Row="1"
                ClipToBounds="True"
                BorderBrush="{DynamicResource ButtonBackground}"
                BorderThickness="1"
            >
                <Panel>
                    <geoMap:MapView x:Name="PART_Map" DataContext="{Binding MapPreview}" />
                    <geoMap:MapZoomControl
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        Zoom="{Binding MapPreview.Zoom.Value, Mode=TwoWay}"
                        MinZoom="{Binding MapPreview.MinZoom.Value}"
                        MaxZoom="{Binding MapPreview.MaxZoom.Value}"
                    />
                    <geoMap:TileProviderSelectorView
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        DataContext="{Binding TileProviderSelectorViewModel}"
                    />
                    <geoMap:MapScaleControl
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8,8,8,60"
                        CenterMap="{Binding MapPreview.CenterMap.Value}"
                        Zoom="{Binding MapPreview.Zoom.Value}"
                        Provider="{Binding MapPreview.CurrentProvider.Value}"
                        UnitService="{Binding UnitService}"
                    />
                    <geoMap:MapCompass
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        GestureSurface="{Binding #PART_Map}"
                        Rotation="{Binding MapPreview.Rotation.Value}"
                    />
                    <geoMap:MapAltitudeToggle
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="54,8,8,8"
                        IsChecked="{Binding MapPreview.ShowAltitudes.Value, Mode=TwoWay}"
                    />
                    <geoMap:MapRuler
                        x:Name="PART_Ruler"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Map="{Binding MapPreview}"
                        UnitService="{Binding UnitService}"
                    />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
