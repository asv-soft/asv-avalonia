<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Asv.Avalonia.GeoMap"
>
    <Design.PreviewWith>
        <Canvas Width="160" Height="120" Background="#435A69">
            <controls:MapCompass
                Width="38"
                Height="38"
                Canvas.Left="18"
                Canvas.Top="18"
                Rotation="18"
            />
        </Canvas>
    </Design.PreviewWith>

    <Style Selector="controls|MapCompass">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="DeadZone" Value="0" />
        <Setter Property="EnableTouchpadGestures" Value="True" />
        <Setter Property="MouseRotationSensitivity" Value="1.0" />
        <Setter Property="TouchpadRotationSensitivity" Value="1.0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_Surface"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    BorderBrush="#3DF3F7FA"
                    BorderThickness="1"
                    BoxShadow="0 2 6 0 #40000000"
                    ClipToBounds="True"
                    CornerRadius="999"
                >
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Offset="0" Color="#E02D3943" />
                            <GradientStop Offset="1" Color="#E029343D" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid IsHitTestVisible="False">
                        <Border x:Name="PART_HoverOverlay" CornerRadius="999" />
                        <Ellipse Margin="4" Stroke="#24FFFFFF" StrokeThickness="1" />

                        <Grid x:Name="PART_NeedleHost" RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <RotateTransform />
                            </Grid.RenderTransform>

                            <Path
                                Width="5"
                                Height="5"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Fill="#FF5A52"
                                Stretch="Fill"
                            >
                                <Path.Data>
                                    <PathGeometry Figures="M 2.5 0 L 5 5 L 2.5 4 L 0 5 Z" />
                                </Path.Data>
                            </Path>

                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="30" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="60" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1.25"
                                    Height="4"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#A8F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="120" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="150" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1.25"
                                    Height="4"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#A8F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="210" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="240" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="270" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1.25"
                                    Height="4"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#A8F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="300" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>
                            <Grid RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="330" />
                                </Grid.RenderTransform>
                                <Border
                                    Width="1"
                                    Height="2.5"
                                    Margin="0,4.5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#70F8FBFF"
                                    CornerRadius="1"
                                />
                            </Grid>

                        </Grid>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#F2F8FBFF"
                            Text="N"
                        />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|MapCompass:pointerover /template/ Border#PART_HoverOverlay">
        <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
</Styles>
