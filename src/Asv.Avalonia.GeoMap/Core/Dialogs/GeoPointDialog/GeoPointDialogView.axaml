<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:map="clr-namespace:Asv.Avalonia.GeoMap;assembly=Asv.Avalonia.GeoMap"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:asv="clr-namespace:Asv.Avalonia;assembly=Asv.Avalonia"
    mc:Ignorable="d"
    Width="500"
    x:CompileBindings="True"
    x:DataType="map:GeoPointDialogViewModel"
    x:Class="Asv.Avalonia.GeoMap.GeoPointDialogView"
>
    <Design.DataContext>
        <map:GeoPointDialogViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.move">
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="0,0,20,0" RowDefinitions="280,Auto">
        <Border
            Grid.Row="0"
            Padding="4"
            BorderBrush="{DynamicResource AsvForegroundUnknownColor}"
            BorderThickness="1"
            CornerRadius="4"
        >
            <Grid>
                <map:MapItemsControl
                    CenterMap="{CompiledBinding CenterGeoPoint.Value, Mode=TwoWay}"
                    Provider="{CompiledBinding CurrentProvider.Value}"
                >
                    <map:MapItemsControl.Styles>
                        <Style Selector="Border.active">
                            <Setter Property="BorderThickness" Value="5" />
                        </Style>
                    </map:MapItemsControl.Styles>
                </map:MapItemsControl>

                <avalonia:MaterialIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Classes="big accent"
                    Kind="Location"
                >
                    <avalonia:MaterialIcon.Effect>
                        <DropShadowEffect
                            BlurRadius="7"
                            OffsetX="0"
                            OffsetY="0"
                            Opacity="0.5"
                            Color="Black"
                        />
                    </avalonia:MaterialIcon.Effect>
                </avalonia:MaterialIcon>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnDefinitions="140,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="8"
        >
            <UniformGrid
                Grid.Row="0"
                Grid.Column="0"
                Rows="3"
                Columns="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
            >
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.UpLeft}"
                >
                    <avalonia:MaterialIcon Kind="ArrowTopLeft" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Forward}"
                >
                    <avalonia:MaterialIcon Kind="ArrowTop" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.UpRight}"
                >
                    <avalonia:MaterialIcon Kind="ArrowTopRight" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Left}"
                >
                    <avalonia:MaterialIcon Kind="ArrowLeft" />
                </Button>
                <Border Width="35" Height="35" Background="Transparent">
                    <avalonia:MaterialIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Kind="MapMarkerRadius"
                    />
                </Border>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Right}"
                >
                    <avalonia:MaterialIcon Kind="ArrowRight" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.DownLeft}"
                >
                    <avalonia:MaterialIcon Kind="ArrowBottomLeft" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Backward}"
                >
                    <avalonia:MaterialIcon Kind="ArrowBottom" />
                </Button>
                <Button
                    Classes="move"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{x:Static map:MoveDirection.DownRight}"
                >
                    <avalonia:MaterialIcon Kind="ArrowBottomRight" />
                </Button>
            </UniformGrid>
            <map:GeoPointDialogStepView
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                DataContext="{Binding HorizontalStep}"
            />

            <ScrollViewer
                Grid.Row="0"
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
            >
                <asv:PropertyEditorView DataContext="{Binding FieldsEditor}" />
            </ScrollViewer>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                <Button
                    Grid.Column="0"
                    Classes="move"
                    Command="{Binding MoveVerticalCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Up}"
                >
                    <avalonia:MaterialIcon Kind="ArrowTop" />
                </Button>
                <Button
                    Grid.Column="1"
                    Classes="move"
                    Command="{Binding MoveVerticalCommand}"
                    CommandParameter="{x:Static map:MoveDirection.Down}"
                >
                    <avalonia:MaterialIcon Kind="ArrowBottom" />
                </Button>
                <map:GeoPointDialogStepView
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    DataContext="{Binding VerticalStep}"
                />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
