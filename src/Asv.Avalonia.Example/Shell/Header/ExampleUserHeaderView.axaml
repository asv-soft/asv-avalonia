<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:example="clr-namespace:Asv.Avalonia.Example"
             x:Class="Asv.Avalonia.Example.ExampleUserHeaderView" x:DataType="example:ExampleUserHeaderViewModel"
             d:DesignWidth="40" d:DesignHeight="32">
    <Design.DataContext><example:ExampleUserHeaderViewModel /></Design.DataContext>
    <Button Height="28" MinHeight="28" MinWidth="28" Padding="2" CornerRadius="16"
            Theme="{DynamicResource TransparentButton}"
            ToolTip.Tip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}">
        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AsvBackgroundInfo3Brush}">
            <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource AsvForegroundInfo3Brush}"
                       FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="8" Width="220" Margin="4">
                    <Grid ColumnDefinitions="44,12,*">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AsvBackgroundInfo3Brush}">
                            <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource AsvForegroundInfo3Brush}"
                                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Email}" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </Grid>
                    <Separator />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
