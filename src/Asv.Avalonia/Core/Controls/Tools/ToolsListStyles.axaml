<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:asv="clr-namespace:Asv.Avalonia"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d"
>
    <Design.PreviewWith>
        <asv:ToolsList Width="500" Height="500" />
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type asv:ToolsList}" TargetType="asv:ToolsList">
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                >
                    <ItemsControl Margin="0,10" ItemsSource="{TemplateBinding ItemsSource}">
                        <ItemsControl.Styles>
                            <Style Selector="TextBlock.description">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <asv:UniformWrapPanel
                                    MinItemWidth="260"
                                    ItemSpacing="8"
                                    LineSpacing="8"
                                />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="asv:IActionViewModel">
                                <Button
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CommandParameter}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    Padding="12,10"
                                    ToolTip.Placement="BottomEdgeAlignedLeft"
                                    ToolTip.VerticalOffset="4"
                                    ToolTip.ShowDelay="200"
                                >
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Header}"
                                                TextWrapping="Wrap"
                                            />
                                            <TextBlock
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap"
                                                IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                    <Grid ColumnDefinitions="30, 12, *">
                                        <avalonia:MaterialIcon
                                            Classes="big"
                                            asv:AsvPalette.Color="{Binding IconColor}"
                                            Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Kind="{Binding Icon}"
                                        />

                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock
                                                Classes="h3"
                                                Text="{Binding Header}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <TextBlock
                                                Classes="description"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                TextTrimming="WordEllipsis"
                                                IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
