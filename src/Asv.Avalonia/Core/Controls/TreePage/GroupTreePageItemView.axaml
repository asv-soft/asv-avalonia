<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonia="clr-namespace:Asv.Avalonia"
    xmlns:avalonia1="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="400"
    x:Class="Asv.Avalonia.GroupTreePageItemView"
    x:Name="PART_Root"
    x:DataType="avalonia:GroupTreePageItemViewModel"
>
    <Design.DataContext>
        <avalonia:GroupTreePageItemViewModel />
    </Design.DataContext>

    <ItemsControl Margin="8" ItemsSource="{Binding Node.Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <avalonia:UniformWrapPanel MinItemWidth="320" ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    HorizontalContentAlignment="Stretch"
                    Command="{ReflectionBinding DataContext.NavigateCommand, ElementName=PART_Root}"
                    MinHeight="100"
                    Padding="12,10"
                    CommandParameter="{Binding Base.NavigateTo}"
                >
                    <Grid ColumnDefinitions="48,12,*">
                        <avalonia1:MaterialIcon
                            Classes="big"
                            Grid.Column="0"
                            avalonia:AsvPalette.Color="{Binding Base.IconColor}"
                            Kind="{Binding Base.Icon}"
                            VerticalAlignment="Top"
                            Width="48"
                            Height="48"
                        />
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                            <TextBlock
                                Classes="h3"
                                FontSize="22"
                                Text="{Binding Base.Header}"
                                TextTrimming="CharacterEllipsis"
                            />
                            <TextBlock
                                Classes="description"
                                Text="{Binding Base.Description}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"
                                IsVisible="{Binding Base.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            />
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
